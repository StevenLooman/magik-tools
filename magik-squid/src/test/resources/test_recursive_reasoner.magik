_package user

## Test exemplar.
def_slotted_exemplar(
    :test_exemplar,
    {
	{:slot1, _unset},
	{:slot2, 1}
    })
$

_method test_exemplar.depth3()
    ## Depth 3.
    _return _self.depth2()
_endmethod
$

_method test_exemplar.depth2()
    ## Depth 2.
    _return _self.depth1()
_endmethod
$

_method test_exemplar.depth1()
    ## Depth 1.
    _return _self.depth0()
_endmethod
$

_method test_exemplar.depth0()
    ## Depth 0.
    _return 0
_endmethod
$

_iter _method test_exemplar.iter_depth3()
    ## Iter depth 3.
    _for i _over _self.iter_depth2()
    _loop
        _return i
    _endloop
_endmethod
$

_iter _method test_exemplar.iter_depth2()
    ## Iter depth 2.
    _for i _over _self.iter_depth1()
    _loop
        _loopbody(i)
    _endloop
_endmethod
$

_iter _method test_exemplar.iter_depth1()
    ## Iter depth 1.
    _for i _over _self.iter_depth0()
    _loop
        _loopbody(i)
    _endloop
_endmethod
$

_iter _method test_exemplar.iter_depth0()
    ## Iter depth 1.
    _loopbody(0)
_endmethod
$

_method test_exemplar.slot1_assign_depth3()
    ## Depth 3.
    .slot1 << _self.depth3()
_endmethod
$
