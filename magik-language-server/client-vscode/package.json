{
  "name": "magik-language-server",
  "description": "Magik Language Server",
  "author": "Steven Looman",
  "license": "GPL-3.0-only",
  "version": "0.13.0-SNAPSHOT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StevenLooman/magik-tools"
  },
  "publisher": "StevenLooman",
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "magik"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onCommand:magik.startSession",
    "onDebug",
    "onDebugInitialConfigurations",
    "onDebugResolve:magik",
    "onTaskType:run_alias",
    "workspaceContains:**/product.def"
  ],
  "extensionKind": ["workspace"],
  "main": "./client/out/extension",
  "contributes": {
    "languages": [
      {
        "id": "sw-product-def",
        "aliases": [
          "Smallworld Product definition"
        ],
        "filenames": [
          "product.def"
        ],
        "configuration": "./languages/sw-product-def-language-configuration.json"
      },
      {
        "id": "sw-module-def",
        "aliases": [
          "Smallworld Module definition"
        ],
        "filenames": [
          "module.def"
        ],
        "configuration": "./languages/sw-module-def-language-configuration.json"
      },
      {
        "id": "sw-load-list",
        "aliases": [
          "Smallworld Load List"
        ],
        "filenames": [
          "load_list.txt",
          "patch_list.txt"
        ],
        "configuration": "./languages/load-list-language-configuration.json"
      },
      {
        "id": "magik",
        "aliases": [
          "Magik"
        ],
        "extensions": [
          ".magik"
        ],
        "configuration": "./languages/magik-language-configuration.json"
      },
      {
        "id": "message",
        "aliases": [
          "Message"
        ],
        "extensions": [
          ".msg"
        ],
        "configuration": "./languages/message-language-configuration.json"
      },
      {
        "id": "translation",
        "aliases": [
          "Translation"
        ],
        "extensions": [
          ".trn"
        ],
        "configuration": "./languages/translation-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "magik",
        "scopeName": "source.magik",
        "path": "./syntaxes/magik.tmGrammar.json"
      }
    ],
    "snippets": [
      {
        "language": "magik",
        "path": "./snippets/magik-snippets.json"
      },
      {
        "language": "sw-load-list",
        "path": "./snippets/sw-load-list-snippets.json"
      },
      {
        "language": "sw-product-def",
        "path": "./snippets/sw-product-def-snippets.json"
      },
      {
        "language": "sw-module-def",
        "path": "./snippets/sw-module-def-snippets.json"
      },
      {
        "language": "message",
        "path": "./snippets/message-snippets.json"
      }
    ],
    "breakpoints": [
      {
        "language": "magik"
      }
    ],
    "debuggers": [
      {
        "type": "magik",
        "label": "Magik",
        "languages": [
          "magik"
        ],
        "variables": {},
        "configurationSnippets": [],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "connect": {
                "label": "Attach by connecting to the MDA interface",
                "type": "object",
                "description": "The connection properties used to connect to the MDA interface over a TCP socket.",
                "properties": {
                  "port": {
                    "label": "Port",
                    "type": "number",
                    "description": "Port to connect to.",
                    "default": 32000
                  },
                  "host": {
                    "label": "Host",
                    "type": "string",
                    "description": "Hostname or IP address to connect to.",
                    "default": "127.0.0.1"
                  },
                  "path_mapping": {
                    "default": [],
                    "label": "Path mapping",
                    "description": "Path mapping",
                    "type": "array",
                    "items": {
                      "label": "Path substitution",
                      "type": "object",
                      "properties": {
                        "from": {
                          "label": "From path",
                          "type": "string"
                        },
                        "to": {
                          "label": "To path",
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "connect"
            ]
          }
        },
        "initialConfigurations": [
          {
            "type": "magik",
            "name": "Attach magik debugger",
            "request": "attach"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "magik.munit.runTest",
        "title": "Run MUnit test",
        "category": "Magik"
      },
      {
        "command": "magik.session.addProduct",
        "title": "Add product to session",
        "category": "Magik"
      },
      {
        "command": "magik.session.loadModule",
        "title": "Load module in session",
        "category": "Magik"
      },
      {
        "command": "magik.traceStatement",
        "title": "Trace statement",
        "category": "Magik"
      },
      {
        "command": "magik.reIndex",
        "title": "Re-index workspace",
        "category": "Magik"
      },
      {
        "command": "magik.startLanguageServer",
        "title": "Start Language Server",
        "category": "Magik"
      },
      {
        "command": "magik.stopLanguageServer",
        "title": "Stop Language Server",
        "category": "Magik"
      }
    ],
    "keybindings": [
      {
        "command": "magik.transmitFile",
        "key": "f4 b",
        "when": "editorTextFocus && editorLangId == magik"
      },
      {
        "command": "magik.transmitCurrentRegion",
        "key": "f4 enter",
        "when": "editorTextFocus && editorLangId == magik"
      },
      {
        "command": "magik.transmitLoadList",
        "key": "f4 b",
        "when": "editorTextFocus && editorLangId == sw-load-list"
      },
      {
        "command": "magik.transmitProductDef",
        "key": "f4 b",
        "when": "editorTextFocus && editorLangId == sw-product-def"
      },
      {
        "command": "magik.transmitModuleDef",
        "key": "f4 b",
        "when": "editorTextFocus && editorLangId == sw-module-def"
      },
      {
        "command": "magik.traceStatement",
        "key": "f4 t",
        "when": "editorTextFocus && editorLangId == magik"
      }
    ],
    "taskDefinitions": [
      {
        "type": "run_alias",
        "required": [
          "entry"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "description": "Name of entry in aliases file"
          },
          "args": {
            "type": "array",
            "description": "Additional runalias arguments"
          },
          "env": {
            "type": "object",
            "description": "Environment variables"
          },
          "aliasesPath": {
            "type": "path",
            "description": "Override aliases path"
          },
          "environmentPath": {
            "type": "path",
            "description": "Override environment path"
          },
          "useSessionWrapper": {
            "type": "boolean",
            "description": "Override use session wrapper"
          }
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Smallworld/Magik",
      "properties": {
        "magik.smallworldGis": {
          "description": "Path to Smallworld Core -- only used by the VS Code extension.",
          "type": "string"
        },
        "magik.sourcePathMappings": {
          "description": "Rewrite recorded source-path prefixes so library definitions resolve on this host. Maps a prefix -- a logical (e.g. \"$SOMS_DIR\") or an absolute path (e.g. \"C:/projects/hg/gma\") -- to a local path or another logical, which is expanded in turn. The longest matching prefix wins.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "magik.javaHome": {
          "description": "Path to Java Runtime, Java 17 minimum -- only used by the VS Code extension.",
          "type": "string"
        },
        "magik.aliases": {
          "description": "Path to gis_aliases file -- only used by the VS Code extension.",
          "type": "string"
        },
        "magik.environment": {
          "description": "Path to environment file -- only used by the VS Code extension.",
          "type": "string"
        },
        "magik.useSessionWrapper": {
          "description": "Use Smallworld session wrapper -- only used by the VS Code extension.",
          "type": "boolean",
          "default": true
        },
        "magik.session.encoding": {
          "description": "Character encoding of the Magik session, used when transmitting a file or region that has no `#% text_encoding =` declaration. Should match the session's locale (e.g. `utf8`, `iso8859_1`). Only used by the VS Code extension.",
          "type": "string",
          "default": "utf8"
        },
        "magik.editor.matchDeclaredEncoding": {
          "description": "Automatically set the editor's character encoding to the one declared in a Magik file's `#% text_encoding = ...` line when opening it. Note: an EditorConfig `charset` for `*.magik` will override this. Only used by the VS Code extension.",
          "type": "boolean",
          "default": true
        },
        "magik.productDirs": {
          "description": "Paths to (compiled, containing a `libs/` directory) products.",
          "type": "array"
        },
        "magik.lint.overrideConfigFile": {
          "description": "Override path to magiklintrc.properties.",
          "type": "string"
        },
        "magik.lint.runChecksOnChangeDelay": {
          "description": "Run checks delayed after <value> milliseconds since last change. The next update resets the delay.",
          "minimum": 0,
          "type": "integer",
          "default": 333
        },
        "magik.lint.runChecksOnSave": {
          "description": "Run checks when saving the file, immediately.",
          "type": "boolean",
          "default": false
        },
        "magik.typing.typeDatabasePaths": {
          "description": "Paths to type databases.",
          "type": "array"
        },
        "magik.typing.showTypingInlayHints": {
          "description": "Show typing inlay hints.",
          "type": "boolean",
          "default": false
        },
        "magik.typing.showArgumentInlayHints": {
          "description": "Show (certain) argument name inlay hints.",
          "type": "boolean",
          "default": false
        },
        "magik.typing.enableChecks": {
          "description": "Enable typing checks.",
          "type": "boolean",
          "default": false
        },
        "magik.typing.indexGlobalUsages": {
          "description": "Enable indexing of usages of globals by methods.",
          "type": "boolean",
          "default": true
        },
        "magik.typing.indexMethodUsages": {
          "description": "Enable indexing of usages of methods by methods.",
          "type": "boolean",
          "default": false
        },
        "magik.typing.indexSlotUsages": {
          "description": "Enable indexing of usages of slots by methods.",
          "type": "boolean",
          "default": true
        },
        "magik.typing.indexConditionUsages": {
          "description": "Enable indexing of usages of conditions by methods.",
          "type": "boolean",
          "default": true
        },
        "magik.typing.cacheIndexedDefinitions": {
          "description": "Store and load the indexed definitions in the workspace folders, in file types.jsonl.",
          "type": "boolean",
          "default": true
        },
        "magik.formatting.indentStrategy": {
          "description": "Indent strategy to use",
          "type": "string",
          "enum": [
            "block",
            "null",
            "relative",
            "visual"
          ],
          "default": "visual"
        },
        "magik.formatting.indentChar": {
          "description": "Indent character, 'tab' or 'space'",
          "type": "string",
          "default": "tab"
        },
        "magik.formatting.indentWidth": {
          "description": "Indent width (tab size or number of spaces)",
          "type": "number",
          "default": 8
        },
        "magik.formatting.insertFinalNewline": {
          "description": "Insert final newline",
          "type": "boolean",
          "default": true
        },
        "magik.formatting.trimTrailingWhitespace": {
          "description": "Trim trailing whitespace",
          "type": "boolean",
          "default": true
        },
        "magik.formatting.trimFinalNewlines": {
          "description": "Trim final newlines",
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "scripts": {
    "eslint": "eslint .",
    "vscode:prepublish": "npm run rebuild",
    "compile": "tsc -b",
    "rebuild": "tsc -b --clean && tsc -b",
    "watch": "tsc -b -w",
    "test": "TS_NODE_PROJECT=client/tsconfig.test.json mocha",
    "postinstall": "cd client && npm install && cd .. && cd server && rm -rf ./* && cp ../../../magik-language-server/target/magik-language-server-*.jar . && cp ../../../magik-debug-adapter/target/magik-debug-adapter-*.jar . && cp ../../../magik-session-wrapper/target/magik-session-wrapper-*.jar . && cd ..",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
