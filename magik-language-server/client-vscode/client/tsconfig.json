{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2019",
		"lib": ["ES2019"],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"skipLibCheck": true
	},
	// Production build: compile the extension entry point and everything it imports.
	// Test files (`*.test.ts`) are not reachable from here, so they are naturally kept
	// out of the shipped output; they are type-checked and run via `tsconfig.test.json`.
	"files": ["src/extension.ts"]
}
